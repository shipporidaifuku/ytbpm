{
  "manifest_version": 2,
  "name": "ytbpm",
  "version": "1.0",
  "description": "YouTubeの動画で楽曲のBPM（と2倍の値）を実測して表示します。動画タイトルからDeezerに登録されたBPMも調べます。",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "ytbpm@daifuku9",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["websiteContent"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "permissions": ["https://api.deezer.com/*"],
  "background": {
    "scripts": ["src/lookup.js", "src/background.js"],
    "persistent": false
  },
  "content_scripts": [
    {
      "matches": ["*://www.youtube.com/*", "*://music.youtube.com/*"],
      "js": ["src/bpm.js", "src/content.js"],
      "css": ["src/content.css"],
      "run_at": "document_idle"
    }
  ]
}
